SMARTCITIZEN_USERNAME="<your smartcitizen user>"
SMARTCITIZEN_TOKEN="<your smartcitizen api token>"
NTFY_TOKEN="<your ntfy token>"
NTFY_DEFAULT_WEBHOOK_URL="https://ntfy.sh/test?template=alertmanager"
NTFY_CRITICAL_WEBHOOK_URL="https://ntfy.sh/critical-test?template=alertmanager"

# Container registry credentials (used by deploy:credentials and deploy:ci:credentials)
DOCKER_USERNAME="<your registry username>"
DOCKER_PASSWORD="<your registry password or access token>"

# Container registry configuration (optional).
# Defaults target public Docker Hub, so leave these unset unless you use a
# private/internal registry. Used by release:docker, release:helm, deploy:helm
# and deploy:ci:credentials.
# REGISTRY_HOST="docker.io"                 # image registry host
# OCI_REGISTRY_HOST="registry-1.docker.io"  # Helm OCI host (differs on Docker Hub)
# REGISTRY_NAMESPACE="tauho"                # Docker Hub user/org or registry project
# IMAGE_NAME="smcprober"                    # image name
# REGISTRY_INSECURE="false"                 # "true" only for plain-HTTP registries
# IMAGE_PULL_SECRET=""                      # imagePullSecret for the Helm chart

# GitHub webhook secret (used by deploy:webhook:secret)
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET="<random secret, configure same value in GitHub webhook settings>"
