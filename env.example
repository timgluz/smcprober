SMARTCITIZEN_USERNAME="<your smartcitizen user>"
SMARTCITIZEN_TOKEN="<your smartcitizen api token>"
NTFY_TOKEN="<your ntfy token>"
NTFY_DEFAULT_WEBHOOK_URL="https://ntfy.sh/test?template=alertmanager"
NTFY_CRITICAL_WEBHOOK_URL="https://ntfy.sh/critical-test?template=alertmanager"

# Docker Hub credentials (used by deploy:credentials and deploy:ci:credentials)
DOCKER_USERNAME="<your dockerhub username>"
DOCKER_PASSWORD="<your dockerhub password or access token>"

# GitHub webhook secret (used by deploy:webhook:secret)
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET="<random secret, configure same value in GitHub webhook settings>"
