{
  extends: [
    'config:recommended',
  ],
  timezone: 'UTC',
  labels: [
    'dependencies',
    'renovate',
  ],
  assignees: [
    'timgluz',
  ],
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  dependencyDashboard: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
    ],
    assignees: [
      'timgluz',
    ],
  },
  semanticCommits: 'enabled',
  rebaseWhen: 'behind-base-branch',
  postUpdateOptions: [
    'gomodTidy',
  ],
  packageRules: [
    {
      matchCategories: [
        'docker',
      ],
      pinDigests: true,
    },
    {
      schedule: [
        'before 10am on monday',
      ],
      matchPackageNames: [
        '*',
      ],
    },
    {
      matchUpdateTypes: [
        'pin',
        'digest',
        'patch',
      ],
      schedule: [
        'at any time',
      ],
      labels: [
        'dependencies',
        'renovate',
        'security',
      ],
      matchPackageNames: [
        '*',
      ],
    },
    {
      matchManagers: [
        'gomod',
      ],
      groupName: 'Go module dependencies',
      semanticCommitType: 'chore',
      semanticCommitScope: 'deps',
      prBodyNotes: [
        'This PR updates Go module dependencies.',
        'All changes are grouped together for efficient review.',
      ],
    },
    {
      // Renovate does not bump the `go` directive in go.mod by default, so the
      // minimum Go version silently drifts behind the Dockerfile builder image.
      // See https://docs.renovatebot.com/modules/manager/gomod/#updating-of-go-mod-and-toolchain-directives
      description: 'Bump the go directive in go.mod to the latest Go release',
      matchManagers: [
        'gomod',
      ],
      matchDepNames: [
        'go',
      ],
      matchDepTypes: [
        'golang',
      ],
      rangeStrategy: 'bump',
      groupName: 'Go version',
      semanticCommitType: 'chore',
      semanticCommitScope: 'build',
      prBodyNotes: [
        'This PR bumps the minimum Go version in go.mod.',
        'Keep the Dockerfile builder image and the pinned golangci-lint in sync before merging.',
      ],
    },
    {
      matchManagers: [
        'dockerfile',
      ],
      groupName: 'Docker dependencies',
      semanticCommitType: 'chore',
      semanticCommitScope: 'docker',
      prBodyNotes: [
        'This PR updates Docker base images.',
        'Digests are pinned for reproducible builds.',
      ],
    },
    {
      matchManagers: [
        'helm-values',
        'helmv3',
      ],
      groupName: 'Helm dependencies',
      semanticCommitType: 'chore',
      semanticCommitScope: 'helm',
      prBodyNotes: [
        'This PR updates Helm chart dependencies.',
        'Test the chart in a dev environment before merging.',
      ],
    },
    {
      matchDepTypes: [
        'devDependencies',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
      prBodyNotes: [
        '⚡ This PR is eligible for auto-merge (minor/patch dev dependency).',
      ],
    },
  ],
  // PR titles are derived from the commit message subject. Semantic commits
  // are enabled, so the `chore(scope):` prefix comes from semanticPrefix and
  // the topic defaults to `{{depName}}`.
  commitMessageAction: 'update',
  commitMessageExtra: 'to {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}v{{{newMajor}}}{{else}}{{#if isSingleVersion}}v{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}{{/if}}{{/if}}',
}
